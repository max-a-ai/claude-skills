[project]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
description = "{{DESCRIPTION}}"
requires-python = ">={{PYTHON_VERSION}},<{{PYTHON_UPPER}}"
dependencies = []

[project.scripts]
{{PROJECT_NAME}} = "{{MODULE_NAME}}.app:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["{{MODULE_NAME}}"]

[dependency-groups]
dev = [
    "ruff>=0.8",
    "mypy>=1.11",
    "pytest>=8",
]
debug = [
    "jupyter>=1.1",
    "ipywidgets>=8.1",
    "nbformat>=5.10",
    "nbclient>=0.10",
]

[tool.uv]
default-groups = ["dev", "debug"]

[tool.ruff]
line-length = 79
target-version = "{{PYTHON_TAG}}"
src = ["."]
extend-exclude = ["third_party", "notebooks", "resources", "outputs"]

[tool.ruff.lint]
select = [
    "E",
    "F",
    "W",
    "I",
    "B",
    "UP",
    "SIM",
    "RET",
    "N",
]

[tool.ruff.format]
quote-style = "double"

[tool.mypy]
python_version = "{{PYTHON_VERSION}}"
strict = true
files = ["{{MODULE_NAME}}", "tests"]
warn_unused_ignores = true
warn_redundant_casts = true

[tool.pytest.ini_options]
testpaths = ["tests"]
